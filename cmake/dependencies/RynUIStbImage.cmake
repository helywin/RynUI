include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/RynUIDependencyLock.cmake")
function(rynui_resolve_stb_image)
    if(RYNUI_DEPENDENCY_MODE STREQUAL "BUNDLED")
        include(FetchContent)
        FetchContent_Declare(rynui_stb
            URL "${RYNUI_STB_SOURCE_URL}"
            URL_HASH "SHA256=${RYNUI_STB_SOURCE_SHA256}"
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE
            SOURCE_SUBDIR __rynui_header_only)
        FetchContent_MakeAvailable(rynui_stb)
        set(header_directory "${rynui_stb_SOURCE_DIR}")
    elseif(RYNUI_DEPENDENCY_MODE STREQUAL "SYSTEM")
        set(RYNUI_SYSTEM_STB_IMAGE_DIRECTORY "" CACHE PATH "Directory containing the locked stb_image.h")
        set(header_directory "${RYNUI_SYSTEM_STB_IMAGE_DIRECTORY}")
    else()
        message(FATAL_ERROR "stb_image requires explicit BUNDLED or SYSTEM mode")
    endif()
    if(NOT EXISTS "${header_directory}/stb_image.h")
        message(FATAL_ERROR "Provide the locked stb_image.h; no implicit system search or fallback")
    endif()
    file(SHA256 "${header_directory}/stb_image.h" actual_hash)
    if(NOT actual_hash STREQUAL RYNUI_STB_IMAGE_HEADER_SHA256)
        message(FATAL_ERROR "stb_image.h does not match the audited lock")
    endif()
    add_library(rynui_stb_image INTERFACE)
    add_library(RynUI::StbImage ALIAS rynui_stb_image)
    target_include_directories(rynui_stb_image SYSTEM INTERFACE "${header_directory}")
endfunction()
