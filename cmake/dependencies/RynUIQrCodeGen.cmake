include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/RynUIDependencyLock.cmake")
function(rynui_resolve_qrcodegen)
    if(RYNUI_DEPENDENCY_MODE STREQUAL "BUNDLED")
        include(FetchContent)
        FetchContent_Declare(rynui_qrcodegen_source
            URL "${RYNUI_QRCODEGEN_SOURCE_URL}"
            URL_HASH "SHA256=${RYNUI_QRCODEGEN_SOURCE_SHA256}"
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE
            SOURCE_SUBDIR __rynui_no_upstream_build)
        FetchContent_MakeAvailable(rynui_qrcodegen_source)
        set(source_directory "${rynui_qrcodegen_source_SOURCE_DIR}/cpp")
    elseif(RYNUI_DEPENDENCY_MODE STREQUAL "SYSTEM")
        set(RYNUI_SYSTEM_QRCODEGEN_DIRECTORY "" CACHE PATH "Directory containing locked qrcodegen.hpp and qrcodegen.cpp")
        set(source_directory "${RYNUI_SYSTEM_QRCODEGEN_DIRECTORY}")
    else()
        message(FATAL_ERROR "qrcodegen requires explicit BUNDLED or SYSTEM mode")
    endif()
    foreach(file IN ITEMS qrcodegen.hpp qrcodegen.cpp)
        if(NOT EXISTS "${source_directory}/${file}")
            message(FATAL_ERROR "Provide locked qrcodegen C++ sources; no implicit search or fallback")
        endif()
        file(SHA256 "${source_directory}/${file}" actual_hash)
        if(file STREQUAL "qrcodegen.hpp")
            set(expected_hash "${RYNUI_QRCODEGEN_HEADER_SHA256}")
        else()
            set(expected_hash "${RYNUI_QRCODEGEN_CPP_SHA256}")
        endif()
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "${file} does not match the audited qrcodegen lock")
        endif()
    endforeach()
    add_library(rynui_qrcodegen STATIC "${source_directory}/qrcodegen.cpp")
    add_library(RynUI::QrCodeGen ALIAS rynui_qrcodegen)
    target_compile_features(rynui_qrcodegen PRIVATE cxx_std_11)
    target_include_directories(rynui_qrcodegen SYSTEM PUBLIC "${source_directory}")
endfunction()
