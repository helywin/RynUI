include_guard(GLOBAL)

set(RYNUI_PLATFORM_BACKEND "SDL" CACHE STRING "Host backend: SDL or HEADLESS")
set_property(CACHE RYNUI_PLATFORM_BACKEND PROPERTY STRINGS SDL HEADLESS)
set(RYNUI_RENDER_BACKENDS "SDL_GPU" CACHE STRING "Renderer backends: SDL_GPU;RECORDING")

if(NOT RYNUI_PLATFORM_BACKEND MATCHES "^(SDL|HEADLESS)$")
    message(FATAL_ERROR "Unsupported RYNUI_PLATFORM_BACKEND: ${RYNUI_PLATFORM_BACKEND}")
endif()
if(NOT RYNUI_RENDER_BACKENDS)
    message(FATAL_ERROR "RYNUI_RENDER_BACKENDS must select at least one renderer")
endif()
foreach(backend IN LISTS RYNUI_RENDER_BACKENDS)
    if(NOT backend MATCHES "^(SDL_GPU|RECORDING)$")
        message(FATAL_ERROR "Unsupported renderer backend: ${backend}")
    endif()
endforeach()
if("SDL_GPU" IN_LIST RYNUI_RENDER_BACKENDS AND NOT RYNUI_PLATFORM_BACKEND STREQUAL "SDL")
    message(FATAL_ERROR "SDL_GPU requires the SDL platform backend")
endif()
if(RYNUI_BUILD_EXAMPLES AND NOT "SDL_GPU" IN_LIST RYNUI_RENDER_BACKENDS)
    message(FATAL_ERROR "Current native examples require SDL + SDL_GPU; set RYNUI_BUILD_EXAMPLES=OFF")
endif()

set(RYNUI_HAS_SDL_HOST OFF)
set(RYNUI_HAS_SDL_GPU OFF)
if(RYNUI_PLATFORM_BACKEND STREQUAL "SDL")
    set(RYNUI_HAS_SDL_HOST ON)
endif()
if("SDL_GPU" IN_LIST RYNUI_RENDER_BACKENDS)
    set(RYNUI_HAS_SDL_GPU ON)
endif()
