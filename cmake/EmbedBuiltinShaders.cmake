# Fixed built-in shader inputs only; Windows uses its native RC compiler instead.
if(NOT DEFINED SHADER_DIRECTORY OR NOT DEFINED SHADER_FILES OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Embedded shader generation requires SHADER_DIRECTORY, SHADER_FILES and OUTPUT")
endif()
set(source "#include \"renderer/sdl/shader_resources.hpp\"\n#include <stdexcept>\n#include <string>\n\nnamespace {\n")
set(lookups "")
set(index 0)
string(REPEAT "0x[0-9a-fA-F][0-9a-fA-F]," 16 line_pattern)
foreach(filename IN LISTS SHADER_FILES)
    file(READ "${SHADER_DIRECTORY}/${filename}" bytes HEX)
    if(bytes STREQUAL "")
        message(FATAL_ERROR "Cannot embed an empty shader: ${filename}")
    endif()
    string(REGEX REPLACE "(..)" "0x\\1," values "${bytes}")
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" values "${values}")
    string(APPEND source "alignas(16) const unsigned char shader_${index}[] = {\n${values}\n};\n")
    string(APPEND lookups "    if (filename == \"${filename}\") { return std::as_bytes(std::span{shader_${index}}); }\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND source "}\nnamespace ryn::detail {\nstd::span<const std::byte> builtin_shader_bytes(std::string_view filename) {\n${lookups}    throw std::runtime_error(\"Missing embedded shader resource: \" + std::string(filename));\n}\n}\n")
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
else()
    set(previous "")
endif()
if(NOT source STREQUAL previous)
    file(WRITE "${OUTPUT}" "${source}")
endif()
