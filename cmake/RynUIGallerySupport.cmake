# CPU-only Gallery support is shared by native examples and HEADLESS tests.
find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
file(GLOB rynui_gallery_public_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/include/ryn/*.hpp")
set(rynui_gallery_source_output "${CMAKE_CURRENT_BINARY_DIR}/gallery-generated/generated_gallery_source.inc")
add_custom_command(
    OUTPUT "${rynui_gallery_source_output}"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/generate_gallery_source.py"
        --root "${PROJECT_SOURCE_DIR}" --output "${rynui_gallery_source_output}"
    DEPENDS "${PROJECT_SOURCE_DIR}/tools/generate_gallery_source.py"
        "${PROJECT_SOURCE_DIR}/examples/token_gallery/token_gallery_definition.cpp"
        ${rynui_gallery_public_headers}
    VERBATIM
)


# Embed a content fingerprint of actual native inputs, including dirty sources.
file(GLOB_RECURSE rynui_demo_build_inputs CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/include/*" "${PROJECT_SOURCE_DIR}/src/*"
    "${PROJECT_SOURCE_DIR}/examples/token_gallery/*" "${PROJECT_SOURCE_DIR}/shaders/*"
    "${PROJECT_SOURCE_DIR}/cmake/*" "${PROJECT_SOURCE_DIR}/gallery/*" "${PROJECT_SOURCE_DIR}/design-tokens/*")
set(rynui_gallery_demo_build "${CMAKE_CURRENT_BINARY_DIR}/gallery-generated/generated_gallery_demo_build.inc")
add_custom_command(OUTPUT "${rynui_gallery_demo_build}"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/demo_differential/source_closure.py"
        --root "${PROJECT_SOURCE_DIR}" --output "${rynui_gallery_demo_build}"
    DEPENDS ${rynui_demo_build_inputs} "${PROJECT_SOURCE_DIR}/CMakeLists.txt"
        "${PROJECT_SOURCE_DIR}/CMakePresets.json" "${PROJECT_SOURCE_DIR}/tools/generate_gallery_source.py"
        "${PROJECT_SOURCE_DIR}/tools/demo_differential/source_closure.py"
        "${PROJECT_SOURCE_DIR}/tests/CMakeLists.txt"
        "${PROJECT_SOURCE_DIR}/tests/demo_differential_calibration_main.cpp"
        "${PROJECT_SOURCE_DIR}/tests/demo_differential_control_geometry.hpp"
        "${PROJECT_SOURCE_DIR}/docs/renderer-contract.md"
        "${PROJECT_SOURCE_DIR}/tests/fixtures/demo-differential/pilot-calibration.json"
    VERBATIM)

# Read the same deterministic input as decoder/resource tests; generated bytes stay in the build tree.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tests/fixtures/images/colors.png")
file(READ "${PROJECT_SOURCE_DIR}/tests/fixtures/images/colors.png" rynui_media_fixture_hex HEX)
string(REGEX REPLACE "(..)" "0x\\1," rynui_media_fixture_bytes "${rynui_media_fixture_hex}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/gallery-generated")
set(rynui_media_fixture_path "${CMAKE_CURRENT_BINARY_DIR}/gallery-generated/generated_media_fixture.inc")
set(rynui_media_fixture_content "inline constexpr unsigned char media_fixture_png[]{${rynui_media_fixture_bytes}};\n")
set(rynui_media_fixture_previous "")
if(EXISTS "${rynui_media_fixture_path}")
    file(READ "${rynui_media_fixture_path}" rynui_media_fixture_previous)
endif()
if(NOT rynui_media_fixture_previous STREQUAL rynui_media_fixture_content)
    file(WRITE "${rynui_media_fixture_path}" "${rynui_media_fixture_content}")
endif()

