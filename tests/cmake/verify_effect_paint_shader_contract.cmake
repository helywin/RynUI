cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SHADER_DIRECTORY PROJECT_ROOT PYTHON_EXECUTABLE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
execute_process(COMMAND "${PYTHON_EXECUTABLE}" -B "${PROJECT_ROOT}/tools/effect_shader_closure.py"
    --root "${PROJECT_ROOT}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Effect paint source closure: ${error}")
endif()
foreach(shader IN ITEMS rounded_effect_paint)
set(attribute_count 8)
set(last_attribute 7)
foreach(stage IN ITEMS vertex fragment)
    file(READ "${SHADER_DIRECTORY}/${shader}.${stage}.json" reflection)
    foreach(resource IN ITEMS samplers storage_textures storage_buffers uniform_buffers)
        string(JSON count ERROR_VARIABLE error GET "${reflection}" ${resource})
        set(expected 0)
        if(stage STREQUAL "fragment" AND resource STREQUAL "storage_buffers")
            set(expected 2)
        endif()
        if(error OR NOT count EQUAL expected)
            message(FATAL_ERROR "Effect paint ${stage} ${resource} must be ${expected}")
        endif()
    endforeach()
endforeach()
file(READ "${SHADER_DIRECTORY}/${shader}.vertex.json" reflection)
string(JSON count LENGTH "${reflection}" inputs)
if(NOT count EQUAL attribute_count)
    message(FATAL_ERROR "${shader} requires ${attribute_count} attributes")
endif()
foreach(index RANGE 0 ${last_attribute})
    string(JSON location GET "${reflection}" inputs ${index} location)
    string(JSON type GET "${reflection}" inputs ${index} type)
    set(expected float4)
    if(index GREATER_EQUAL 7)
        set(expected uint4)
    endif()
    if(NOT location EQUAL index OR NOT type STREQUAL expected)
        message(FATAL_ERROR "Effect paint attribute ${index}: ${type}@${location}, expected ${expected}")
    endif()
endforeach()
file(READ "${PROJECT_ROOT}/shaders/rounded_effect.lock.yaml" lock)
string(JSON count LENGTH "${lock}" pipelines ${shader} closure)
math(EXPR last "${count} - 1")
foreach(stage IN ITEMS vertex fragment)
    foreach(extension IN ITEMS dxil spv json)
        set(artifact "${SHADER_DIRECTORY}/${shader}.${stage}.${extension}")
        if(NOT EXISTS "${artifact}")
            message(FATAL_ERROR "Missing effect paint artifact: ${artifact}")
        endif()
        file(TIMESTAMP "${artifact}" built "%s")
        file(TIMESTAMP "${PROJECT_ROOT}/shaders/rounded_effect.lock.yaml" lock_modified "%s")
        if(built LESS lock_modified)
            message(FATAL_ERROR "Stale effect paint artifact vs lock: ${artifact}")
        endif()
        foreach(index RANGE 0 ${last})
            string(JSON source GET "${lock}" pipelines ${shader} closure ${index})
            file(TIMESTAMP "${PROJECT_ROOT}/${source}" modified "%s")
            if(built LESS modified)
                message(FATAL_ERROR "Stale effect paint artifact: ${artifact} vs ${source}")
            endif()
        endforeach()
    endforeach()
endforeach()
endforeach()
message(STATUS "Effect paint JSON resource/IO reflection passed; SPIR-V layout and real DXIL consumption are separate tests")
